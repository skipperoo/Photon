<?xml version="1.0" encoding="utf-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="TARGETDIR">
      <Directory Id="DesktopFolder" Name="Desktop" />
    </DirectoryRef>
    <DirectoryRef Id="DesktopFolder">
      <Component Id="PhotonDesktopShortcut" Guid="*">
        <Shortcut Id="PhotonDesktopShortcutLink"
                  Name="Photon"
                  Description="Professional RAW image editor"
                  Target="[INSTALL_ROOT]\bin\Photon.exe"
                  WorkingDirectory="INSTALL_ROOT" />
        <RegistryValue Root="HKCU"
                       Key="Software\RBLabs\Photon"
                       Name="desktopShortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
