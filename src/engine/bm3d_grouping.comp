#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer LumaBuffer {
    float luma[];
};

layout(std430, binding = 1) writeonly buffer GroupedBuffer {
    float grouped_data[]; // (numGroups * groupSize * 64)
};

layout(std430, binding = 2) writeonly buffer GroupOffsets {
    ivec2 offsets[]; // (numGroups * groupSize)
};

layout(std430, binding = 3) readonly buffer SearchResults {
    vec4 results[]; // (best_dx, best_dy, min_ssd, 1.0)
};

layout(push_constant) uniform Params {
    int width;
    int height;
    int stride;
    int groupSize;
} pcs;

void main() {
    int x = int(gl_GlobalInvocationID.x) * pcs.stride;
    int y = int(gl_GlobalInvocationID.y) * pcs.stride;
    
    if (x >= pcs.width - 8 || y >= pcs.height - 8) return;

    int g_width = (pcs.width - 8 + pcs.stride - 1) / pcs.stride;
    int g_idx = (y / pcs.stride) * g_width + (x / pcs.stride);
    
    // For now, groupSize is 2: Reference block + Best match
    // 1. Reference Block
    for (int by = 0; by < 8; by++) {
        for (int bx = 0; bx < 8; bx++) {
            grouped_data[(g_idx * pcs.groupSize + 0) * 64 + by * 8 + bx] = luma[(y + by) * pcs.width + (x + bx)];
        }
    }
    offsets[g_idx * pcs.groupSize + 0] = ivec2(x, y);

    // 2. Best Match
    vec4 search = results[y * pcs.width + x];
    int best_x = x + int(search.x);
    int best_y = y + int(search.y);
    
    for (int by = 0; by < 8; by++) {
        for (int bx = 0; bx < 8; bx++) {
            grouped_data[(g_idx * pcs.groupSize + 1) * 64 + by * 8 + bx] = luma[(best_y + by) * pcs.width + (best_x + bx)];
        }
    }
    offsets[g_idx * pcs.groupSize + 1] = ivec2(best_x, best_y);
}
