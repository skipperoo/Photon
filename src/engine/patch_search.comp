#version 450

layout(local_size_x = 16, local_size_y = 16) in;

layout(std430, binding = 0) readonly buffer LumaBuffer {
    float luma[];
};

layout(std430, binding = 1) writeonly buffer ResultBuffer {
    vec4 results[];
};

layout(push_constant) uniform PushConstants {
    int width;
    int height;
    int searchWindow;
} pcs;

void main() {
    int x = int(gl_GlobalInvocationID.x);
    int y = int(gl_GlobalInvocationID.y);
    
    if (x >= pcs.width || y >= pcs.height) return;

    int idx = y * pcs.width + x;
    float min_ssd = 1000000.0;
    vec2 best_offset = vec2(0.0);
    
    float center_patch[9];
    for (int py = -1; py <= 1; py++) {
        for (int px = -1; px <= 1; px++) {
            int lx = clamp(x + px, 0, pcs.width - 1);
            int ly = clamp(y + py, 0, pcs.height - 1);
            center_patch[(py + 1) * 3 + (px + 1)] = luma[ly * pcs.width + lx];
        }
    }

    int radius = pcs.searchWindow / 2;
    for (int dy = -radius; dy <= radius; dy++) {
        for (int dx = -radius; dx <= radius; dx++) {
            if (dx == 0 && dy == 0) continue;
            
            float ssd = 0.0;
            for (int py = -1; py <= 1; py++) {
                for (int px = -1; px <= 1; px++) {
                    int cx = clamp(x + dx + px, 0, pcs.width - 1);
                    int cy = clamp(y + dy + py, 0, pcs.height - 1);
                    float diff = luma[cy * pcs.width + cx] - center_patch[(py + 1) * 3 + (px + 1)];
                    ssd += diff * diff;
                }
            }
            
            if (ssd < min_ssd) {
                min_ssd = ssd;
                best_offset = vec2(float(dx), float(dy));
            }
        }
    }
    
    results[idx] = vec4(best_offset.x, best_offset.y, min_ssd, 1.0);
}
